{
  "buildCommand": "node src/build.mjs",
  "outputDirectory": "public",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "Permissions-Policy",
          "value": "microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/offset",
      "destination": "/api/manage?action=offset"
    },
    {
      "source": "/api/admin-excel",
      "destination": "/api/manage?action=excel"
    },
    {
      "source": "/api/product-quote",
      "destination": "/api/prices?resource=product-quote"
    },
    {
      "source": "/api/retail-prices",
      "destination": "/api/prices?resource=retail-prices"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  }
}
